{
  "name": "nexron-chat",
  "private": true,
  "version": "0.7.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/build-app.mjs && node scripts/forget-stale-bundles.mjs",
    "release:windows": "node scripts/release-windows.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:bridge": "npm --prefix bridge test",
    "test:rust": "cargo test --manifest-path agentd/Cargo.toml --features fake-claude",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.73.0",
    "@tanstack/vue-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
